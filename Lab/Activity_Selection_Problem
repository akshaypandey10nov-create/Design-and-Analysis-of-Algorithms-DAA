#include <stdio.h>

int main() {
    int n, i, j;
    int s[20], f[20];

    printf("Enter number of activities: ");
    scanf("%d", &n);

    printf("Enter start times:\n");
    for (i = 0; i < n; i++)
        scanf("%d", &s[i]);

    printf("Enter finish times:\n");
    for (i = 0; i < n; i++)
        scanf("%d", &f[i]);

    printf("Selected activities: 1 ");

    j = 0;

    for (i = 1; i < n; i++) {
        if (s[i] >= f[j]) {
            printf("%d ", i + 1);
            j = i;
        }
    }

    return 0;
}
